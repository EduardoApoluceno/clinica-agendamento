# Copie para .env e ajuste. O perfil demo funciona SEM .env (usa padrões só de demonstração).
# Em PRODUÇÃO todos os valores abaixo são obrigatórios e devem ser fortes (ex.: openssl rand -base64 32).

# Perfil Spring do backend: demo | prod
SPRING_PERFIL=prod
APP_VERSAO=0.1.0

# URLs públicas
APP_URL_PUBLICA=https://app.suaclinica.com.br
KC_URL_PUBLICA=https://auth.suaclinica.com.br
KC_URL_INTERNA=http://keycloak:8180

# PostgreSQL
POSTGRES_SUPERUSER_PASSWORD=
DB_MIGRATION_PASSWORD=
DB_APP_PASSWORD=
KC_DB_PASSWORD=

# Redis
REDIS_PASSWORD=

# Criptografia de campos (AES-256 e HMAC-SHA256, 32 bytes em Base64: openssl rand -base64 32)
APP_CRIPTO_CHAVE_ATIVA=k1
APP_CRIPTO_CHAVE_K1=
APP_CRIPTO_CHAVE_HMAC=

# Keycloak
KC_COMANDO=start --import-realm
KC_REALM_DIR=realm-prod
KC_PROXY_HEADERS=xforwarded
KC_ADMIN_USUARIO=
KC_ADMIN_SENHA=
KC_CLIENTE_BFF_SEGREDO=
KC_BIND=127.0.0.1:8180

# Exposição: em prod o "web" só é alcançado pelo Caddy de borda (sem porta publicada no host).
WEB_BIND=127.0.0.1:8080
REDE_BORDA=borda

# Observabilidade (demo local)
GRAFANA_SENHA=
