<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!-- Beans Spring injetados por construtor são compartilhados por design. -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>
    <!-- Construtores de @Configuration que validam e lançam exceção são intencionais. -->
    <Match>
        <Bug pattern="CT_CONSTRUCTOR_THROW"/>
        <Class name="~.*Config"/>
    </Match>
</FindBugsFilter>
