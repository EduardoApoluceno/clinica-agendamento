<?xml version="1.0"?>
<!DOCTYPE suppressions PUBLIC "-//Checkstyle//DTD SuppressionFilter Configuration 1.2//EN"
        "https://checkstyle.org/dtds/suppressions_1_2.dtd">
<suppressions>
    <!-- A classe @SpringBootApplication precisa de construtor público instanciável pelo Spring. -->
    <suppress checks="HideUtilityClassConstructor" files="ClinicaApplication\.java"/>
    <!-- Métodos @Bean de *Config só ligam dependências dos casos de uso (sem lógica); o limite de
         parâmetros vale para código de negócio. -->
    <suppress checks="ParameterNumber" files="[\\/]infrastructure[\\/]\w+Config\.java"/>
</suppressions>
